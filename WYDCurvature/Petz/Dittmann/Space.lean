import WYDCurvature.Petz.Dittmann.Plane

/-!
# Dittmann's function `hs` off the diagonals: closed-form derivatives

Dittmann's inequalities (64) and (65) follow from the concavity of `hs` along the segments
`(x, y, λ) → (y, x, λ)` and `(x, λ, µ) → (y, λ, µ)`, i.e. from the signs of `∂₁₁hs` and of
`(∂₁ - ∂₂)²hs = ∂₁₁hs - 2 ∂₁₂hs + ∂₂₂hs`. At pairwise distinct arguments `hs` is an explicit
rational function of `x`, `y`, `z` and `a = log x - log z`, `b = log y - log z` (Dittmann's (61),
`bkmHs_eq_dittmannHs`), and so are its derivatives along lines in the first two arguments.

As on the plane (`Dittmann/Plane.lean`), polynomials in `x`, `y`, `z`, `a`, `b` are lists of
monomials with integer coefficients (`spaceEval`). Along a line `t ↦ (X t, Y t, z)` with
`X' = dx`, `Y' = dy`, `d/dt p = (dx Θ₁ p + dy Θ₂ p) / (x y)` with the polynomials
`Θ₁ p = x y ∂ₓp + y ∂ₐp` and `Θ₂ p = x y ∂ᵧp + x ∂_b p` (`hasDerivAt_spaceEval`). Two steps of the
quotient rule, with the reduced numerators given as data and checked by kernel computation
(`ListPoly`, `decide +kernel`), give `∂₁hs`,
`∂₁₁hs` and `∂₁₂hs` in closed form; `∂₂₂hs` is `∂₁₁hs` with `x ↔ y`, `a ↔ b`, and the numerator of
`(∂₁ - ∂₂)²hs` is assembled from those of `∂₁₁hs` and `∂₁₂hs` by one linear identity.

For the signs (`Certificates.lean`): the numerators are homogeneous in `x`, `y`, `z`, so `z = 1`
suffices; with `x = e^A`, `y = e^B` the plane of `(A, B)` is covered by the six cones of the
orderings of `A`, `B`, `0`, and on a cone `A = s₁ p + t₁ q`, `B = s₂ p + t₂ q` (`p, q ≥ 0`) a
polynomial becomes `e^{a₀ p + b₀ q}` times a polynomial in `e^p`, `e^q`, `p`, `q` (`sectorEval`).

## Main definitions

* `PetzCurvature.spaceEval`, `PetzCurvature.spaceTheta₁`,
  `PetzCurvature.spaceTheta₂`: polynomials in `x`, `y`, `z`, `a`, `b` and their derivatives
  along lines.
* `PetzCurvature.spaceHs`, `PetzCurvature.spaceD₁`, `PetzCurvature.spaceD₁₁`,
  `PetzCurvature.spaceD₁₂`: `hs`, `∂₁hs`, `∂₁₁hs`, `∂₁₂hs` off the diagonals, as rational
  functions of `x`, `y`, `z`, `a`, `b`.
* `PetzCurvature.spaceNum₁₁`, `PetzCurvature.spaceNum₃`: the numerators of `∂₁₁hs` and
  of `(∂₁ - ∂₂)²hs` (377 and 990 monomials).
* `PetzCurvature.sectorEval`, `PetzCurvature.poly₂`: a polynomial on a sector, and an
  exponential polynomial, as polynomials in `e^p`, `e^q`, `p`, `q`.
* `PetzCurvature.Sector`, `PetzCurvature.Sector.data`: a cone, and a polynomial on it
  as an exponential polynomial computed by Lean.
* `PetzCurvature.spaceToList`, `PetzCurvature.spaceQuot`: the identities as `ListPoly`
  computations.

## Main statements

* `PetzCurvature.hasDerivAt_spaceEval`: the derivative of a polynomial in `x`, `y`, `z`,
  `log x - log z`, `log y - log z` along a line.
* `PetzCurvature.bkmHs_space`: `hs = spaceHs` at pairwise distinct positive arguments.
* `PetzCurvature.hasDerivAt_spaceHs`, `PetzCurvature.hasDerivAt_spaceD₁`: the first
  and second derivatives of `hs` along lines, off the diagonals.
* `PetzCurvature.spaceD₁₂_swap`: `∂₁₂hs` is symmetric.
* `PetzCurvature.spaceD₁₁_sub_spaceD₁₂_add`: `(∂₁ - ∂₂)²hs = P₃ / Q₃` with
  `P₃ = spaceNum₃`.
* `PetzCurvature.spaceEval_sector`, `PetzCurvature.eval₂_eq_poly₂`: the passage to
  polynomials in `e^p`, `e^q`, `p`, `q`.
* `PetzCurvature.spaceEval_homogeneous`, `PetzCurvature.spaceEval_nonpos_of_sectors`:
  `z = 1` and the six sectors suffice.
* `PetzCurvature.spaceEval_nonpos_of_checks`: `P ≤ 0` on a sector from five kernel checks.

## References

* [J. Dittmann, *On the curvature of monotone metrics and a conjecture concerning the
  Kubo–Mori metric*][dittmann1999]

-/

namespace PetzCurvature

open ExpPolynomial

/-! ### Polynomials in `x`, `y`, `z`, `a`, `b` along lines -/

/-- A polynomial in `x`, `y`, `z`, `a`, `b` with integer coefficients, as a list of monomials:
`(c, i, j, k, l, m)` stands for `c xⁱ yʲ zᵏ aˡ bᵐ`. -/
def spaceEval (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (x y z a b : ℝ) : ℝ :=
  (p.map fun (c, i, j, k, l, m) ↦ (c : ℝ) * x ^ i * y ^ j * z ^ k * a ^ l * b ^ m).sum

/-- `Θ₁ p = x y ∂ₓp + y ∂ₐp`: with `a = log x - log z`, `x y ∂/∂x` of `p`. -/
def spaceTheta₁ (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) :=
  p.flatMap fun (c, i, j, k, l, m) ↦ [(c * i, i, j + 1, k, l, m), (c * l, i, j + 1, k, l - 1, m)]

/-- `Θ₂ p = x y ∂ᵧp + x ∂_b p`: with `b = log y - log z`, `x y ∂/∂y` of `p`. -/
def spaceTheta₂ (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) :=
  p.flatMap fun (c, i, j, k, l, m) ↦ [(c * j, i + 1, j, k, l, m), (c * m, i + 1, j, k, l, m - 1)]

theorem spaceEval_nil (x y z a b : ℝ) : spaceEval [] x y z a b = 0 := rfl

theorem spaceEval_cons (c : ℤ) (i j k l m : ℕ) (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (x y z a b : ℝ) :
    spaceEval ((c, i, j, k, l, m) :: p) x y z a b =
      c * x ^ i * y ^ j * z ^ k * a ^ l * b ^ m + spaceEval p x y z a b :=
  List.sum_cons

theorem spaceEval_append (p q : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (x y z a b : ℝ) :
    spaceEval (p ++ q) x y z a b = spaceEval p x y z a b + spaceEval q x y z a b := by
  simp [spaceEval]

theorem spaceTheta₁_nil : spaceTheta₁ [] = [] := rfl

theorem spaceTheta₂_nil : spaceTheta₂ [] = [] := rfl

theorem spaceTheta₁_cons (c : ℤ) (i j k l m : ℕ) (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    spaceTheta₁ ((c, i, j, k, l, m) :: p) =
      [(c * i, i, j + 1, k, l, m), (c * l, i, j + 1, k, l - 1, m)] ++ spaceTheta₁ p := rfl

theorem spaceTheta₂_cons (c : ℤ) (i j k l m : ℕ) (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    spaceTheta₂ ((c, i, j, k, l, m) :: p) =
      [(c * j, i + 1, j, k, l, m), (c * m, i + 1, j, k, l, m - 1)] ++ spaceTheta₂ p := rfl

theorem spaceTheta₁_append (p q : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    spaceTheta₁ (p ++ q) = spaceTheta₁ p ++ spaceTheta₁ q :=
  List.flatMap_append

theorem spaceTheta₂_append (p q : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    spaceTheta₂ (p ++ q) = spaceTheta₂ p ++ spaceTheta₂ q :=
  List.flatMap_append

variable {X Y : ℝ → ℝ} {dx dy t z : ℝ}

theorem hasDerivAt_spaceMono (hX : HasDerivAt X dx t) (hY : HasDerivAt Y dy t) (hX0 : 0 < X t)
    (hY0 : 0 < Y t) (c : ℤ) (i j k l m : ℕ) :
    HasDerivAt (fun t ↦ (c : ℝ) * X t ^ i * Y t ^ j * z ^ k *
        (Real.log (X t) - Real.log z) ^ l * (Real.log (Y t) - Real.log z) ^ m)
      ((dx * spaceEval (spaceTheta₁ [(c, i, j, k, l, m)]) (X t) (Y t) z
          (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) +
        dy * spaceEval (spaceTheta₂ [(c, i, j, k, l, m)]) (X t) (Y t) z
          (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z)) / (X t * Y t)) t := by
  have hA := (hX.log hX0.ne').sub_const (Real.log z)
  have hB := (hY.log hY0.ne').sub_const (Real.log z)
  have h := (((((hX.pow i).const_mul (c : ℝ)).mul (hY.pow j)).mul_const (z ^ k)).mul
    (hA.pow l)).mul (hB.pow m)
  refine h.congr_deriv ?_
  simp only [spaceTheta₁_cons, spaceTheta₂_cons, spaceTheta₁_nil, spaceTheta₂_nil,
    List.append_nil, spaceEval_cons, spaceEval_nil]
  push_cast
  simp only [Pi.mul_apply, Pi.pow_apply]
  field_simp
  linear_combination (dx * (c : ℝ) * Y t ^ (j + 1) * z ^ k * (Real.log (X t) - Real.log z) ^ l *
      (Real.log (Y t) - Real.log z) ^ m) * natCast_mul_pow_pred_mul i (X t) +
    (dy * (c : ℝ) * X t ^ (i + 1) * z ^ k * (Real.log (X t) - Real.log z) ^ l *
      (Real.log (Y t) - Real.log z) ^ m) * natCast_mul_pow_pred_mul j (Y t)

/-- **Polynomials in `x`, `y`, `z`, `log x - log z`, `log y - log z` along a line**:
`d/dt p = (dx Θ₁ p + dy Θ₂ p) / (x y)`. -/
theorem hasDerivAt_spaceEval (hX : HasDerivAt X dx t) (hY : HasDerivAt Y dy t) (hX0 : 0 < X t)
    (hY0 : 0 < Y t) (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    HasDerivAt (fun t ↦ spaceEval p (X t) (Y t) z (Real.log (X t) - Real.log z)
        (Real.log (Y t) - Real.log z))
      ((dx * spaceEval (spaceTheta₁ p) (X t) (Y t) z (Real.log (X t) - Real.log z)
          (Real.log (Y t) - Real.log z) +
        dy * spaceEval (spaceTheta₂ p) (X t) (Y t) z (Real.log (X t) - Real.log z)
          (Real.log (Y t) - Real.log z)) / (X t * Y t)) t := by
  induction p with
  | nil => simpa [spaceEval_nil, spaceTheta₁_nil, spaceTheta₂_nil] using hasDerivAt_const t (0 : ℝ)
  | cons m p ih =>
    obtain ⟨c, i, j, k, l, n⟩ := m
    have h := (hasDerivAt_spaceMono (z := z) hX hY hX0 hY0 c i j k l n).add ih
    simp only [spaceEval_cons]
    refine h.congr_deriv ?_
    rw [show ((c, i, j, k, l, n) :: p) = [(c, i, j, k, l, n)] ++ p from rfl, spaceTheta₁_append,
      spaceTheta₂_append, spaceEval_append, spaceEval_append]
    ring

/-- The quotient rule for `spaceEval p / spaceEval q` along a line. -/
theorem hasDerivAt_spaceEval_div (hX : HasDerivAt X dx t) (hY : HasDerivAt Y dy t)
    (hX0 : 0 < X t) (hY0 : 0 < Y t) (p q : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (hq : spaceEval q (X t) (Y t) z (Real.log (X t) - Real.log z)
      (Real.log (Y t) - Real.log z) ≠ 0) :
    HasDerivAt (fun t ↦ spaceEval p (X t) (Y t) z (Real.log (X t) - Real.log z)
        (Real.log (Y t) - Real.log z) / spaceEval q (X t) (Y t) z (Real.log (X t) - Real.log z)
          (Real.log (Y t) - Real.log z))
      ((dx * (spaceEval (spaceTheta₁ p) (X t) (Y t) z (Real.log (X t) - Real.log z)
            (Real.log (Y t) - Real.log z) * spaceEval q (X t) (Y t) z
              (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) -
          spaceEval p (X t) (Y t) z (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) *
            spaceEval (spaceTheta₁ q) (X t) (Y t) z (Real.log (X t) - Real.log z)
              (Real.log (Y t) - Real.log z)) +
        dy * (spaceEval (spaceTheta₂ p) (X t) (Y t) z (Real.log (X t) - Real.log z)
            (Real.log (Y t) - Real.log z) * spaceEval q (X t) (Y t) z
              (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) -
          spaceEval p (X t) (Y t) z (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) *
            spaceEval (spaceTheta₂ q) (X t) (Y t) z (Real.log (X t) - Real.log z)
              (Real.log (Y t) - Real.log z))) /
        (X t * Y t * spaceEval q (X t) (Y t) z (Real.log (X t) - Real.log z)
          (Real.log (Y t) - Real.log z) ^ 2)) t := by
  refine ((hasDerivAt_spaceEval hX hY hX0 hY0 p).div
    (hasDerivAt_spaceEval hX hY hX0 hY0 q) hq).congr_deriv ?_
  have := hX0.ne'
  have := hY0.ne'
  field_simp
  ring

