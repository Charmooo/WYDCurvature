/-! ### The polynomial identities, by kernel computation

Each identity is checked as an identity of `ListPoly` polynomials in the variables `x, y, z, a, b`
(numbered `0, …, 4`) by `decide +kernel`, and read back over `ℝ` through `eval_spaceToList`. -/

section Identities

open ListPoly

/-- A polynomial in `x`, `y`, `z`, `a`, `b` as a `ListPoly` in the variables `0, …, 4`. -/
def spaceToList (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List Mono :=
  p.map fun (c, i, j, k, l, m) ↦ mono c [i, j, k, l, m]

@[simp] theorem eval_spaceToList (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (x y z a b : ℝ) :
    eval (spaceToList p) [x, y, z, a, b] = spaceEval p x y z a b := by
  induction p with
  | nil => rfl
  | cons t p ih =>
    obtain ⟨c, i, j, k, l, m⟩ := t
    rw [spaceToList, List.map_cons, eval_cons, ← spaceToList, ih, spaceEval_cons]
    simp only [mono, evalExp]
    ring

/-- The exchange `x ↔ y`, `a ↔ b`. -/
def spaceSwap (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) :=
  p.map fun (c, i, j, k, l, m) ↦ (c, j, i, k, m, l)

@[simp] theorem spaceEval_spaceSwap (p : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (x y z a b : ℝ) :
    spaceEval (spaceSwap p) x y z a b = spaceEval p y x z b a := by
  induction p with
  | nil => rfl
  | cons t p ih =>
    obtain ⟨c, i, j, k, l, m⟩ := t
    rw [spaceSwap, List.map_cons, spaceEval_cons, ← spaceSwap, ih, spaceEval_cons]
    ring

/-- The quotient-rule numerator `θ N · D - N · θ D`. -/
def spaceQuot (θ : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) → List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (N D : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List Mono :=
  sub (mul (spaceToList D) (norm (spaceToList (θ N))))
    (mul (spaceToList N) (norm (spaceToList (θ D))))

@[simp] theorem eval_spaceQuot (θ : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) → List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (N D : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (x y z a b : ℝ) :
    eval (spaceQuot θ N D) [x, y, z, a, b] = spaceEval (θ N) x y z a b * spaceEval D x y z a b -
      spaceEval N x y z a b * spaceEval (θ D) x y z a b := by
  simp only [spaceQuot, eval_sub, eval_mul, eval_norm, eval_spaceToList]
  ring

local notation "𝐱" => var 0
local notation "𝐲" => var 1
local notation "𝐳" => var 2
local notation "𝐚" => var 3
local notation "𝐛" => var 4

theorem spaceDen₀_check : sub (norm (spaceToList spaceDen₀))
    (smul 6 (prod [𝐱, 𝐲, 𝐳, sub 𝐱 𝐲, sub 𝐱 𝐳, sub 𝐲 𝐳, sub 𝐚 𝐛, 𝐚, 𝐛])) = [] := by
  decide +kernel

theorem spaceDen₁_check : sub (norm (spaceToList spaceDen₁)) (smul 6 (prod [pow 𝐚 2, 𝐛, pow 𝐱 2,
    𝐲, 𝐳, pow (sub 𝐚 𝐛) 2, pow (sub 𝐱 𝐲) 2, pow (sub 𝐱 𝐳) 2, sub 𝐲 𝐳])) = [] := by
  decide +kernel

theorem spaceNum₁_check : sub (spaceQuot spaceTheta₁ spaceNum₀ spaceDen₀)
    (smul 6 (prod [𝐛, 𝐱, pow 𝐲 2, 𝐳, sub 𝐲 𝐳, spaceToList spaceNum₁])) = [] := by
  decide +kernel

theorem spaceNum₂_check : sub (spaceQuot spaceTheta₂ spaceNum₀ spaceDen₀)
    (smul 6 (prod [𝐚, 𝐲, pow 𝐱 2, 𝐳, sub 𝐱 𝐳, spaceToList (spaceSwap spaceNum₁)])) = [] := by
  decide +kernel

theorem spaceNum₁₁_check : sub (spaceQuot spaceTheta₁ spaceNum₁ spaceDen₁) (smul 6 (prod [𝐚, 𝐛,
    pow 𝐱 2, pow 𝐲 2, 𝐳, sub 𝐚 𝐛, sub 𝐱 𝐲, sub 𝐱 𝐳, sub 𝐲 𝐳, spaceToList spaceNum₁₁])) = [] := by
  decide +kernel

theorem spaceNum₁₂_check : sub (spaceQuot spaceTheta₂ spaceNum₁ spaceDen₁) (smul 6 (prod
    [pow 𝐚 2, pow 𝐱 3, 𝐲, 𝐳, sub 𝐚 𝐛, sub 𝐱 𝐲, pow (sub 𝐱 𝐳) 2, spaceToList spaceNum₁₂])) =
      [] := by
  decide +kernel

theorem spaceNum₁₂_swap_check :
    sub (norm (spaceToList (spaceSwap spaceNum₁₂))) (norm (spaceToList spaceNum₁₂)) = [] := by
  decide +kernel

theorem spaceNum₃_check : sub (norm (spaceToList spaceNum₃))
    (add (add (mul (spaceToList spaceNum₁₁) (prod [pow 𝐛 2, pow 𝐲 2, pow (sub 𝐲 𝐳) 2]))
      (smul (-2) (prod [spaceToList spaceNum₁₂, 𝐚, 𝐛, 𝐱, 𝐲, sub 𝐱 𝐳, sub 𝐲 𝐳])))
      (mul (spaceToList (spaceSwap spaceNum₁₁)) (prod [pow 𝐚 2, pow 𝐱 2, pow (sub 𝐱 𝐳) 2]))) =
      [] := by
  decide +kernel

theorem spaceDen₀_eq (x y z a b : ℝ) :
    spaceEval spaceDen₀ x y z a b =
      6 * x * y * z * (x - y) * (x - z) * (y - z) * (a - b) * a * b := by
  have h := eval_eq_of_sub_eq_nil spaceDen₀_check [x, y, z, a, b]
  simp only [eval_norm, eval_spaceToList, eval_smul, eval_prod, eval_sub, eval_var_zero,
    eval_var_succ, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil] at h
  linear_combination h

theorem spaceDen₁_eq (x y z a b : ℝ) :
    spaceEval spaceDen₁ x y z a b =
      6 * a ^ 2 * b * x ^ 2 * y * z * (a - b) ^ 2 * (x - y) ^ 2 * (x - z) ^ 2 * (y - z) := by
  have h := eval_eq_of_sub_eq_nil spaceDen₁_check [x, y, z, a, b]
  simp only [eval_norm, eval_spaceToList, eval_smul, eval_prod, eval_sub, eval_pow, eval_var_zero,
    eval_var_succ, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil] at h
  linear_combination h

theorem spaceNum₁_eq (x y z a b : ℝ) :
    spaceEval (spaceTheta₁ spaceNum₀) x y z a b * spaceEval spaceDen₀ x y z a b -
      spaceEval spaceNum₀ x y z a b * spaceEval (spaceTheta₁ spaceDen₀) x y z a b =
        6 * b * x * y ^ 2 * z * (y - z) * spaceEval spaceNum₁ x y z a b := by
  have h := eval_eq_of_sub_eq_nil spaceNum₁_check [x, y, z, a, b]
  simp only [eval_spaceQuot, eval_spaceToList, eval_smul, eval_prod, eval_sub, eval_pow,
    eval_var_zero, eval_var_succ, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil] at h
  linear_combination h

theorem spaceNum₂_eq (x y z a b : ℝ) :
    spaceEval (spaceTheta₂ spaceNum₀) x y z a b * spaceEval spaceDen₀ x y z a b -
      spaceEval spaceNum₀ x y z a b * spaceEval (spaceTheta₂ spaceDen₀) x y z a b =
        6 * a * y * x ^ 2 * z * (x - z) * spaceEval spaceNum₁ y x z b a := by
  have h := eval_eq_of_sub_eq_nil spaceNum₂_check [x, y, z, a, b]
  simp only [eval_spaceQuot, eval_spaceToList, spaceEval_spaceSwap, eval_smul, eval_prod,
    eval_sub, eval_pow, eval_var_zero, eval_var_succ, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil] at h
  linear_combination h

theorem spaceNum₁₁_eq (x y z a b : ℝ) :
    spaceEval (spaceTheta₁ spaceNum₁) x y z a b * spaceEval spaceDen₁ x y z a b -
      spaceEval spaceNum₁ x y z a b * spaceEval (spaceTheta₁ spaceDen₁) x y z a b =
        6 * a * b * x ^ 2 * y ^ 2 * z * (a - b) * (x - y) * (x - z) * (y - z) *
          spaceEval spaceNum₁₁ x y z a b := by
  have h := eval_eq_of_sub_eq_nil spaceNum₁₁_check [x, y, z, a, b]
  simp only [eval_spaceQuot, eval_spaceToList, eval_smul, eval_prod, eval_sub, eval_pow,
    eval_var_zero, eval_var_succ, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil] at h
  linear_combination h

theorem spaceNum₁₂_eq (x y z a b : ℝ) :
    spaceEval (spaceTheta₂ spaceNum₁) x y z a b * spaceEval spaceDen₁ x y z a b -
      spaceEval spaceNum₁ x y z a b * spaceEval (spaceTheta₂ spaceDen₁) x y z a b =
        6 * a ^ 2 * x ^ 3 * y * z * (a - b) * (x - y) * (x - z) ^ 2 *
          spaceEval spaceNum₁₂ x y z a b := by
  have h := eval_eq_of_sub_eq_nil spaceNum₁₂_check [x, y, z, a, b]
  simp only [eval_spaceQuot, eval_spaceToList, eval_smul, eval_prod, eval_sub, eval_pow,
    eval_var_zero, eval_var_succ, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil] at h
  linear_combination h

theorem spaceNum₁₂_swap (x y z a b : ℝ) :
    spaceEval spaceNum₁₂ y x z b a = spaceEval spaceNum₁₂ x y z a b := by
  have h := eval_eq_of_sub_eq_nil spaceNum₁₂_swap_check [x, y, z, a, b]
  rwa [eval_norm, eval_norm, eval_spaceToList, eval_spaceToList, spaceEval_spaceSwap] at h

theorem spaceNum₃_eq (x y z a b : ℝ) :
    spaceEval spaceNum₃ x y z a b =
      spaceEval spaceNum₁₁ x y z a b * (b ^ 2 * y ^ 2 * (y - z) ^ 2) -
        2 * spaceEval spaceNum₁₂ x y z a b * (a * b * x * y * (x - z) * (y - z)) +
          spaceEval spaceNum₁₁ y x z b a * (a ^ 2 * x ^ 2 * (x - z) ^ 2) := by
  have h := eval_eq_of_sub_eq_nil spaceNum₃_check [x, y, z, a, b]
  simp only [eval_norm, eval_spaceToList, spaceEval_spaceSwap, eval_add, eval_mul, eval_smul,
    eval_prod, eval_sub, eval_pow, eval_var_zero, eval_var_succ, List.map_cons, List.map_nil,
    List.prod_cons, List.prod_nil] at h
  linear_combination h

end Identities

/-! ### `hs` and its derivatives off the diagonals -/

/-- `hs` off the diagonals, in `x`, `y`, `z`, `a = log x - log z`, `b = log y - log z`
(`bkmHs_space`). -/
noncomputable def spaceHs (x y z a b : ℝ) : ℝ :=
  spaceEval spaceNum₀ x y z a b / spaceEval spaceDen₀ x y z a b

/-- `∂₁hs` off the diagonals (`hasDerivAt_spaceHs`). -/
noncomputable def spaceD₁ (x y z a b : ℝ) : ℝ :=
  spaceEval spaceNum₁ x y z a b / spaceEval spaceDen₁ x y z a b

/-- `∂₁₁hs` off the diagonals (`hasDerivAt_spaceD₁`). -/
noncomputable def spaceD₁₁ (x y z a b : ℝ) : ℝ :=
  spaceEval spaceNum₁₁ x y z a b /
    (6 * a ^ 3 * b * x ^ 3 * y * z * (a - b) ^ 3 * (x - y) ^ 3 * (x - z) ^ 3 * (y - z))

/-- `∂₁₂hs` off the diagonals (`hasDerivAt_spaceD₁`). -/
noncomputable def spaceD₁₂ (x y z a b : ℝ) : ℝ :=
  spaceEval spaceNum₁₂ x y z a b /
    (6 * a ^ 2 * b ^ 2 * x ^ 2 * y ^ 2 * z * (a - b) ^ 3 * (x - y) ^ 3 * (x - z) ^ 2 * (y - z) ^ 2)

/-- **`hs` off the diagonals in closed form**: Dittmann's (61) as `spaceHs`. -/
theorem bkmHs_space {x y z : ℝ} (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (hxy : x ≠ y) (hxz : x ≠ z)
    (hyz : y ≠ z) :
    bkmHs x y z = spaceHs x y z (Real.log x - Real.log z) (Real.log y - Real.log z) := by
  rw [bkmHs_eq_dittmannHs hx hy hz hxy hxz hyz, dittmannHs, spaceHs, spaceDen₀_eq]
  have := sub_ne_zero.mpr hxy
  have := sub_ne_zero.mpr hxz
  have := sub_ne_zero.mpr hyz
  have := sub_ne_zero.mpr (Real.log_injOn_pos.ne hx hy hxy)
  have := sub_ne_zero.mpr (Real.log_injOn_pos.ne hx hz hxz)
  have := sub_ne_zero.mpr (Real.log_injOn_pos.ne hy hz hyz)
  have e : Real.log x - Real.log z - (Real.log y - Real.log z) = Real.log x - Real.log y := by ring
  rw [e]
  simp only [spaceEval, spaceNum₀, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  push_cast
  field_simp
  ring

/-- The nonvanishing factors off the diagonals. -/
theorem space_ne_zero {x y z : ℝ} (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (hxy : x ≠ y)
    (hxz : x ≠ z) (hyz : y ≠ z) :
    Real.log x - Real.log z ≠ 0 ∧ Real.log y - Real.log z ≠ 0 ∧
      Real.log x - Real.log z - (Real.log y - Real.log z) ≠ 0 :=
  ⟨sub_ne_zero.mpr (Real.log_injOn_pos.ne hx hz hxz),
    sub_ne_zero.mpr (Real.log_injOn_pos.ne hy hz hyz), by
      rw [sub_sub_sub_cancel_right]; exact sub_ne_zero.mpr (Real.log_injOn_pos.ne hx hy hxy)⟩

variable {X Y : ℝ → ℝ} {dx dy t z : ℝ}

/-- **The first derivative of `hs` along a line**, off the diagonals:
`d/dt hs(X, Y, z) = dx ∂₁hs(X, Y, z) + dy ∂₁hs(Y, X, z)`. -/
theorem hasDerivAt_spaceHs (hX : HasDerivAt X dx t) (hY : HasDerivAt Y dy t) (hX0 : 0 < X t)
    (hY0 : 0 < Y t) (hz : 0 < z) (hXY : X t ≠ Y t) (hXz : X t ≠ z) (hYz : Y t ≠ z) :
    HasDerivAt (fun t ↦ spaceHs (X t) (Y t) z (Real.log (X t) - Real.log z)
        (Real.log (Y t) - Real.log z))
      (dx * spaceD₁ (X t) (Y t) z (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) +
        dy * spaceD₁ (Y t) (X t) z (Real.log (Y t) - Real.log z)
          (Real.log (X t) - Real.log z)) t := by
  obtain ⟨ha, hb, hab⟩ := space_ne_zero hX0 hY0 hz hXY hXz hYz
  have hD : spaceEval spaceDen₀ (X t) (Y t) z (Real.log (X t) - Real.log z)
      (Real.log (Y t) - Real.log z) ≠ 0 := by
    rw [spaceDen₀_eq]
    have := sub_ne_zero.mpr hXY
    have := sub_ne_zero.mpr hXz
    have := sub_ne_zero.mpr hYz
    have := hX0.ne'
    have := hY0.ne'
    have := hz.ne'
    apply_rules [mul_ne_zero]
    norm_num
  refine (hasDerivAt_spaceEval_div hX hY hX0 hY0 _ _ hD).congr_deriv ?_
  rw [spaceNum₁_eq, spaceNum₂_eq, spaceD₁, spaceD₁, spaceDen₁_eq, spaceDen₁_eq, spaceDen₀_eq]
  have := sub_ne_zero.mpr hXY
  have := sub_ne_zero.mpr hXY.symm
  have := sub_ne_zero.mpr hXz
  have := sub_ne_zero.mpr hYz
  have := hX0.ne'
  have := hY0.ne'
  have := hz.ne'
  have hba : Real.log (Y t) - Real.log z - (Real.log (X t) - Real.log z) ≠ 0 := by
    intro h; apply hab; linarith
  field_simp
  ring

/-- **The second derivatives of `hs` along a line**, off the diagonals:
`d/dt ∂₁hs(X, Y, z) = dx ∂₁₁hs(X, Y, z) + dy ∂₁₂hs(X, Y, z)`. -/
theorem hasDerivAt_spaceD₁ (hX : HasDerivAt X dx t) (hY : HasDerivAt Y dy t) (hX0 : 0 < X t)
    (hY0 : 0 < Y t) (hz : 0 < z) (hXY : X t ≠ Y t) (hXz : X t ≠ z) (hYz : Y t ≠ z) :
    HasDerivAt (fun t ↦ spaceD₁ (X t) (Y t) z (Real.log (X t) - Real.log z)
        (Real.log (Y t) - Real.log z))
      (dx * spaceD₁₁ (X t) (Y t) z (Real.log (X t) - Real.log z) (Real.log (Y t) - Real.log z) +
        dy * spaceD₁₂ (X t) (Y t) z (Real.log (X t) - Real.log z)
          (Real.log (Y t) - Real.log z)) t := by
  obtain ⟨ha, hb, hab⟩ := space_ne_zero hX0 hY0 hz hXY hXz hYz
  have := sub_ne_zero.mpr hXY
  have := sub_ne_zero.mpr hXz
  have := sub_ne_zero.mpr hYz
  have := hX0.ne'
  have := hY0.ne'
  have := hz.ne'
  have hD : spaceEval spaceDen₁ (X t) (Y t) z (Real.log (X t) - Real.log z)
      (Real.log (Y t) - Real.log z) ≠ 0 := by
    rw [spaceDen₁_eq]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero
      (mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 ha)) hb)
      (pow_ne_zero 2 hX0.ne')) hY0.ne') hz.ne') (pow_ne_zero 2 hab))
      (pow_ne_zero 2 (sub_ne_zero.mpr hXY))) (pow_ne_zero 2 (sub_ne_zero.mpr hXz)))
      (sub_ne_zero.mpr hYz)
  refine (hasDerivAt_spaceEval_div hX hY hX0 hY0 _ _ hD).congr_deriv ?_
  rw [spaceNum₁₁_eq, spaceNum₁₂_eq, spaceD₁₁, spaceD₁₂, spaceDen₁_eq]
  field_simp

/-- `∂₁₂hs` is symmetric. -/
theorem spaceD₁₂_swap (x y z a b : ℝ) : spaceD₁₂ y x z b a = spaceD₁₂ x y z a b := by
  rw [spaceD₁₂, spaceD₁₂, spaceNum₁₂_swap]
  congr 1
  ring

/-- **`(∂₁ - ∂₂)²hs` in closed form**: `∂₁₁hs - 2 ∂₁₂hs + ∂₂₂hs = P₃ / Q₃`, with
`∂₂₂hs(x, y, z) = ∂₁₁hs(y, x, z)`. -/
theorem spaceD₁₁_sub_spaceD₁₂_add {x y z a b : ℝ} (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a - b ≠ 0) (hxy : x - y ≠ 0) (hxz : x - z ≠ 0)
    (hyz : y - z ≠ 0) :
    spaceD₁₁ x y z a b - 2 * spaceD₁₂ x y z a b + spaceD₁₁ y x z b a =
      spaceEval spaceNum₃ x y z a b / (6 * a ^ 3 * b ^ 3 * x ^ 3 * y ^ 3 * z * (a - b) ^ 3 *
        (x - y) ^ 3 * (x - z) ^ 3 * (y - z) ^ 3) := by
  have hba : b - a ≠ 0 := fun h ↦ hab (by linarith)
  have hyx : y - x ≠ 0 := fun h ↦ hxy (by linarith)
  rw [spaceNum₃_eq, spaceD₁₁, spaceD₁₁, spaceD₁₂]
  field_simp
  ring

/-! ### Sectors: `z = 1`, `x = e^A`, `y = e^B` on the cones of the orderings of `A`, `B`, `0` -/

/-- `P(e^A, e^B, 1, A, B)` with `A = s₁ p + t₁ q`, `B = s₂ p + t₂ q`, divided by
`e^{a₀ p + b₀ q}`, as a polynomial in `U = e^p`, `W = e^q`, `p`, `q`. -/
noncomputable def sectorEval (s₁ t₁ s₂ t₂ a₀ b₀ : ℤ) (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (U W p q : ℝ) : ℝ :=
  (P.map fun (c, i, j, _, l, m) ↦ (c : ℝ) * U ^ ((i : ℤ) * s₁ + j * s₂ - a₀).toNat *
    W ^ ((i : ℤ) * t₁ + j * t₂ - b₀).toNat * (s₁ * p + t₁ * q) ^ l * (s₂ * p + t₂ * q) ^ m).sum

theorem sectorEval_nil (s₁ t₁ s₂ t₂ a₀ b₀ : ℤ) (U W p q : ℝ) :
    sectorEval s₁ t₁ s₂ t₂ a₀ b₀ [] U W p q = 0 := rfl

theorem sectorEval_cons (s₁ t₁ s₂ t₂ a₀ b₀ c : ℤ) (i j k l m : ℕ)
    (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) (U W p q : ℝ) :
    sectorEval s₁ t₁ s₂ t₂ a₀ b₀ ((c, i, j, k, l, m) :: P) U W p q =
      c * U ^ ((i : ℤ) * s₁ + j * s₂ - a₀).toNat * W ^ ((i : ℤ) * t₁ + j * t₂ - b₀).toNat *
        (s₁ * p + t₁ * q) ^ l * (s₂ * p + t₂ * q) ^ m + sectorEval s₁ t₁ s₂ t₂ a₀ b₀ P U W p q :=
  List.sum_cons

theorem sectorEval_append (s₁ t₁ s₂ t₂ a₀ b₀ : ℤ) (P P' : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (U W p q : ℝ) :
    sectorEval s₁ t₁ s₂ t₂ a₀ b₀ (P ++ P') U W p q =
      sectorEval s₁ t₁ s₂ t₂ a₀ b₀ P U W p q + sectorEval s₁ t₁ s₂ t₂ a₀ b₀ P' U W p q := by
  simp [sectorEval]

/-- `P(e^A, e^B, 1, A, B) = e^{a₀ p + b₀ q} sectorEval P (e^p) (e^q) p q` when every exponent is
at least the shift. -/
theorem spaceEval_sector {s₁ t₁ s₂ t₂ a₀ b₀ : ℤ} {P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)}
    (h : ∀ t ∈ P, a₀ ≤ (t.2.1 : ℤ) * s₁ + t.2.2.1 * s₂ ∧ b₀ ≤ (t.2.1 : ℤ) * t₁ + t.2.2.1 * t₂)
    {p q A B : ℝ} (hA : A = s₁ * p + t₁ * q) (hB : B = s₂ * p + t₂ * q) :
    spaceEval P (Real.exp A) (Real.exp B) 1 A B =
      Real.exp (a₀ * p + b₀ * q) *
        sectorEval s₁ t₁ s₂ t₂ a₀ b₀ P (Real.exp p) (Real.exp q) p q := by
  subst hA hB
  induction P with
  | nil => simp [spaceEval_nil, sectorEval_nil]
  | cons t P ih =>
    rw [List.forall_mem_cons] at h
    obtain ⟨c, i, j, k, l, m⟩ := t
    rw [spaceEval_cons, sectorEval_cons, ih h.2, mul_add]
    congr 1
    obtain ⟨h1, h2⟩ := h.1
    simp only at h1 h2
    have e1 : (((i : ℤ) * s₁ + j * s₂ - a₀).toNat : ℝ) = i * s₁ + j * s₂ - a₀ := by
      exact_mod_cast Int.toNat_of_nonneg (by omega)
    have e2 : (((i : ℤ) * t₁ + j * t₂ - b₀).toNat : ℝ) = i * t₁ + j * t₂ - b₀ := by
      exact_mod_cast Int.toNat_of_nonneg (by omega)
    have hx : Real.exp (s₁ * p + t₁ * q) ^ i * Real.exp (s₂ * p + t₂ * q) ^ j =
        Real.exp (a₀ * p + b₀ * q) * Real.exp p ^ ((i : ℤ) * s₁ + j * s₂ - a₀).toNat *
          Real.exp q ^ ((i : ℤ) * t₁ + j * t₂ - b₀).toNat := by
      rw [← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_nat_mul,
        ← Real.exp_add, ← Real.exp_add, ← Real.exp_add, e1, e2]
      congr 1
      ring
    rw [one_pow, mul_one]
    linear_combination (c : ℝ) * (s₁ * p + t₁ * q) ^ l * (s₂ * p + t₂ * q) ^ m * hx

/-- `∑ c Uᵅ pⁱ W^β qʲ` over the terms `(c, α, i, β, j)`. -/
noncomputable def poly₂ (r : List (ℤ × ℕ × ℕ × ℕ × ℕ)) (U W p q : ℝ) : ℝ :=
  (r.map fun (c, α, i, β, j) ↦ (c : ℝ) * U ^ α * p ^ i * (W ^ β * q ^ j)).sum

/-- `∑ c W^β qʲ` over the triples `(c, β, j)`. -/
noncomputable def poly₁ (L : List (ℤ × ℕ × ℕ)) (W q : ℝ) : ℝ :=
  (L.map fun (c, β, j) ↦ (c : ℝ) * W ^ β * q ^ j).sum

theorem poly₁_nil (W q : ℝ) : poly₁ [] W q = 0 := rfl

theorem poly₁_cons (c : ℤ) (β j : ℕ) (L : List (ℤ × ℕ × ℕ)) (W q : ℝ) :
    poly₁ ((c, β, j) :: L) W q = c * W ^ β * q ^ j + poly₁ L W q := List.sum_cons

theorem poly₂_flatten₂_nil (U W p q : ℝ) : poly₂ (flatten₂ []) U W p q = 0 := rfl

theorem poly₂_flatten₂_cons (α i : ℕ) (L : List (ℤ × ℕ × ℕ))
    (G : List (ℕ × ℕ × List (ℤ × ℕ × ℕ))) (U W p q : ℝ) :
    poly₂ (flatten₂ ((α, i, L) :: G)) U W p q =
      U ^ α * p ^ i * poly₁ L W q + poly₂ (flatten₂ G) U W p q := by
  rw [show flatten₂ ((α, i, L) :: G) =
    (L.map fun (c, β, j) ↦ (c, α, i, β, j)) ++ flatten₂ G from rfl, poly₂, List.map_append,
    List.sum_append, ← poly₂]
  congr 1
  induction L with
  | nil => simp [poly₂, poly₁_nil]
  | cons t L ih =>
    obtain ⟨c, β, j⟩ := t
    simp only [poly₂, List.map_cons, List.sum_cons, poly₁_cons] at ih ⊢
    rw [ih]
    ring

theorem eval₂_eq_poly₂ (r : List (ℤ × ℕ × ℕ × ℕ × ℕ)) (p q : ℝ) :
    eval₂ r p q = poly₂ r (Real.exp p) (Real.exp q) p q := by
  simp only [eval₂, poly₂, ← Real.exp_nat_mul]

/-- **Homogeneity**: if every monomial has degree `D` in `x`, `y`, `z`, then
`P(x, y, z, a, b) = z^D P(x / z, y / z, 1, a, b)`. -/
theorem spaceEval_homogeneous {P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)} {D : ℕ}
    (h : ∀ t ∈ P, t.2.1 + t.2.2.1 + t.2.2.2.1 = D) (x y a b : ℝ) {z : ℝ} (hz : z ≠ 0) :
    spaceEval P x y z a b = z ^ D * spaceEval P (x / z) (y / z) 1 a b := by
  induction P with
  | nil => simp [spaceEval_nil]
  | cons t P ih =>
    rw [List.forall_mem_cons] at h
    obtain ⟨c, i, j, k, l, m⟩ := t
    rw [spaceEval_cons, spaceEval_cons, ih h.2, mul_add]
    congr 1
    have e : z ^ D = z ^ i * z ^ j * z ^ k := by rw [← h.1, pow_add, pow_add]
    rw [e, div_pow, div_pow, one_pow]
    field_simp

/-- **The six sectors cover the plane**: a polynomial `≤ 0` at `(e^A, e^B, 1, A, B)` on each of
the six cones of the orderings of `A`, `B`, `0` is `≤ 0` everywhere. -/
theorem spaceEval_nonpos_of_sectors {P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)}
    (h₁ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q →
      spaceEval P (Real.exp (p + q)) (Real.exp p) 1 (p + q) p ≤ 0)
    (h₂ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q →
      spaceEval P (Real.exp p) (Real.exp (p + q)) 1 p (p + q) ≤ 0)
    (h₃ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q → spaceEval P (Real.exp q) (Real.exp (-p)) 1 q (-p) ≤ 0)
    (h₄ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q → spaceEval P (Real.exp (-p)) (Real.exp q) 1 (-p) q ≤ 0)
    (h₅ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q →
      spaceEval P (Real.exp (-p)) (Real.exp (-p - q)) 1 (-p) (-p - q) ≤ 0)
    (h₆ : ∀ p q : ℝ, 0 ≤ p → 0 ≤ q →
      spaceEval P (Real.exp (-p - q)) (Real.exp (-p)) 1 (-p - q) (-p) ≤ 0) (A B : ℝ) :
    spaceEval P (Real.exp A) (Real.exp B) 1 A B ≤ 0 := by
  rcases le_total 0 A with hA | hA <;> rcases le_total 0 B with hB | hB
  · rcases le_total B A with hBA | hBA
    · have := h₁ B (A - B) hB (by linarith)
      rwa [show B + (A - B) = A by ring] at this
    · have := h₂ A (B - A) hA (by linarith)
      rwa [show A + (B - A) = B by ring] at this
  · have := h₃ (-B) A (by linarith) hA
    rwa [neg_neg] at this
  · have := h₄ (-A) B (by linarith) hB
    rwa [neg_neg] at this
  · rcases le_total B A with hBA | hBA
    · have := h₅ (-A) (A - B) (by linarith) (by linarith)
      rwa [neg_neg, show A - (A - B) = B by ring] at this
    · have := h₆ (-B) (B - A) (by linarith) (by linarith)
      rwa [neg_neg, show B - (B - A) = A by ring] at this

/-! ### Sector certificates computed in Lean

On a sector, Lean computes the exponential polynomial `-P / e^{a₀ p + b₀ q}` itself: the shift
`(a₀, b₀)` is the least pair of exponents (`Sector.shift`), the binomial expansion is a `ListPoly`
computation in the variables `[q, e^q, p, e^p]` (`sectorToList`), and its terms are grouped by
`(α, i)` (`Sector.data`). The grouping is not proved correct: the kernel checks the identity
(`Sector.identOk`), and `spaceEval_nonpos_of_checks` needs only that check and the four checks of
`ExpPolynomial.coef₂_nonneg_of_checks`. -/

section Certificates

open ListPoly

/-- The cone `A = s₁ p + t₁ q`, `B = s₂ p + t₂ q` (`p, q ≥ 0`). -/
structure Sector where
  /-- The coefficient of `p` in `A`. -/
  s₁ : ℤ
  /-- The coefficient of `q` in `A`. -/
  t₁ : ℤ
  /-- The coefficient of `p` in `B`. -/
  s₂ : ℤ
  /-- The coefficient of `q` in `B`. -/
  t₂ : ℤ

/-- The exponents of `e^p` and `e^q` in `xⁱ yʲ = e^{iA + jB}` on the sector. -/
def Sector.expo (S : Sector) (t : ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℤ × ℤ :=
  ((t.2.1 : ℤ) * S.s₁ + t.2.2.1 * S.s₂, (t.2.1 : ℤ) * S.t₁ + t.2.2.1 * S.t₂)

/-- The shift `(a₀, b₀)`: the least exponents of `e^p` and `e^q` over the monomials. -/
def Sector.shift (S : Sector) : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ) → ℤ × ℤ
  | [] => (0, 0)
  | t :: P => P.foldr (fun u a ↦ (min (S.expo u).1 a.1, min (S.expo u).2 a.2)) (S.expo t)

/-- `s p + t q` in the variables `[q, W, p, U]`. -/
def sectorLin (s t : ℤ) : List Mono := norm [mono s [0, 0, 1], mono t [1]]

/-- `sectorEval` as a `ListPoly` in the variables `[q, W, p, U]` (`eval_sectorToList`). -/
def sectorToList (S : Sector) (a₀ b₀ : ℤ) (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : List Mono :=
  P.flatMap fun t ↦ mul (pow (sectorLin S.s₁ S.t₁) t.2.2.2.2.1)
    (mul (pow (sectorLin S.s₂ S.t₂) t.2.2.2.2.2)
      [mono t.1 [0, ((S.expo t).2 - b₀).toNat, 0, ((S.expo t).1 - a₀).toNat]])

/-- Groups consecutive monomials `c qʲ W^β pⁱ Uᵅ` with the same `(α, i)` into `(α, i, [(c, β, j)])`
(the layout of `ExpPolynomial.flatten₂`). -/
def sectorGroups : List Mono → List (ℕ × ℕ × List (ℤ × ℕ × ℕ))
  | [] => []
  | m :: l =>
    let α := m.2.2.getD 3 0
    let i := m.2.2.getD 2 0
    let t : ℤ × ℕ × ℕ := (m.1, m.2.2.getD 1 0, m.2.2.getD 0 0)
    match sectorGroups l with
    | [] => [(α, i, [t])]
    | (α', i', L) :: G =>
      if Nat.beq α α' && Nat.beq i i' then (α, i, t :: L) :: G
      else (α, i, [t]) :: (α', i', L) :: G

/-- Groups back to a `ListPoly` in the variables `[q, W, p, U]` (`eval_groupsToList`). -/
def groupsToList (G : List (ℕ × ℕ × List (ℤ × ℕ × ℕ))) : List Mono :=
  G.flatMap fun (α, i, L) ↦ L.map fun (c, β, j) ↦ mono c [j, β, i, α]

/-- The exponential polynomial `-P / e^{a₀ p + b₀ q}` on the sector, grouped by `(α, i)`. -/
def Sector.data (S : Sector) (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) :
    List (ℕ × ℕ × List (ℤ × ℕ × ℕ)) :=
  sectorGroups (smul (-1) (norm (sectorToList S (S.shift P).1 (S.shift P).2 P)))

/-- The check that the shift is below every exponent and that `Sector.data` is `-P` on the
sector. -/
def Sector.identOk (S : Sector) (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)) : Bool :=
  P.all (fun t ↦ decide ((S.shift P).1 ≤ (S.expo t).1) && decide ((S.shift P).2 ≤ (S.expo t).2)) &&
    (sub (norm (sectorToList S (S.shift P).1 (S.shift P).2 P))
      (smul (-1) (groupsToList (S.data P)))).isEmpty

/-- The largest `α` of the groups (the `K` of `ExpPolynomial.cornerOk`). -/
def groupsMaxE (G : List (ℕ × ℕ × List (ℤ × ℕ × ℕ))) : ℕ := G.foldr (fun g a ↦ max g.1 a) 0

/-- The largest `i` of the groups (the `d` of `ExpPolynomial.cornerOk`). -/
def groupsMaxI (G : List (ℕ × ℕ × List (ℤ × ℕ × ℕ))) : ℕ := G.foldr (fun g a ↦ max g.2.1 a) 0

theorem eval_sectorLin (s t : ℤ) (q W p U : ℝ) :
    eval (sectorLin s t) [q, W, p, U] = s * p + t * q := by
  simp [sectorLin, mono, evalExp]

theorem eval_sectorToList (S : Sector) (a₀ b₀ : ℤ) (P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ))
    (q W p U : ℝ) :
    eval (sectorToList S a₀ b₀ P) [q, W, p, U] =
      sectorEval S.s₁ S.t₁ S.s₂ S.t₂ a₀ b₀ P U W p q := by
  induction P with
  | nil => rfl
  | cons t P ih =>
    obtain ⟨c, i, j, k, l, m⟩ := t
    rw [sectorToList, List.flatMap_cons, ← sectorToList, eval_append, ih, sectorEval_cons]
    simp [eval_sectorLin, mono, evalExp, Sector.expo]
    ring

theorem eval_groupsToList (G : List (ℕ × ℕ × List (ℤ × ℕ × ℕ))) (q W p U : ℝ) :
    eval (groupsToList G) [q, W, p, U] = poly₂ (flatten₂ G) U W p q := by
  induction G with
  | nil => rfl
  | cons g G ih =>
    obtain ⟨α, i, L⟩ := g
    rw [groupsToList, List.flatMap_cons, ← groupsToList, eval_append, ih, poly₂_flatten₂_cons]
    congr 1
    induction L with
    | nil => simp [poly₁_nil]
    | cons t L ihL =>
      obtain ⟨c, β, j⟩ := t
      simp only [List.map_cons, eval_cons, poly₁_cons] at ihL ⊢
      rw [ihL]
      simp [mono, evalExp]
      ring

/-- **A polynomial is `≤ 0` on a sector** if the kernel checks pass: the identity
(`Sector.identOk`), and the rectangle, the strips and the corner of the Taylor coefficients of
`Sector.data` from `M` on. -/
theorem spaceEval_nonpos_of_checks (S : Sector) {P : List (ℤ × ℕ × ℕ × ℕ × ℕ × ℕ)} {M N : ℕ}
    (hI : S.identOk P = true) (hR : rectOk (S.data P) M N = true)
    (hP : stripPOk (S.data P) M N = true) (hQ : stripQOk (S.data P) M N = true)
    (hC : cornerOk (S.data P) (groupsMaxE (S.data P)) (groupsMaxI (S.data P)) M N = true)
    {p q A B : ℝ} (hp : 0 ≤ p) (hq : 0 ≤ q) (hA : A = S.s₁ * p + S.t₁ * q)
    (hB : B = S.s₂ * p + S.t₂ * q) :
    spaceEval P (Real.exp A) (Real.exp B) 1 A B ≤ 0 := by
  simp only [Sector.identOk, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq,
    List.isEmpty_iff] at hI
  obtain ⟨hE, hS⟩ := hI
  rw [spaceEval_sector (fun t ht ↦ hE t ht) hA hB]
  have e := eval_eq_of_sub_eq_nil hS [q, Real.exp q, p, Real.exp p]
  rw [eval_norm, eval_sectorToList, eval_smul, eval_groupsToList] at e
  rw [e, ← eval₂_eq_poly₂]
  have := eval₂_nonneg (coef₂_nonneg_of_checks hR hP hQ hC) hp hq
  push_cast
  exact mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le (by linarith)

end Certificates

end PetzCurvature
